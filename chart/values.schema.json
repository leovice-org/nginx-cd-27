{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "NginxWebServer Values",
    "type": "object",
    "properties": {
        "image": {
            "type": "object",
            "title": "Image settings",
            "properties": {
                "repository": {
                    "type": "string",
                    "title": "Image repository"
                },
                "tag": {
                    "type": "string",
                    "title": "Image tag"
                }
            }
        },
        "service": {
            "type": "object",
            "title": "Service settings",
            "properties": {
                "type": {
                    "type": "string",
                    "title": "Service type"
                },
                "port": {
                    "type": "integer",
                    "title": "Service port"
                }
            }
        }
    }
}
